<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationIcon>Markadian Icon.ico</ApplicationIcon>
		<PackageIcon>Markadian Icon.ico</PackageIcon>

		<Title>Markadian Playlister</Title>
		<AssemblyVersion>1.0.0</AssemblyVersion>
		<FileVersion>1.0.1</FileVersion>
		<Copyright>Markadian Records</Copyright>

		<Optimize>true</Optimize>
		<DebugType>none</DebugType>

		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>

		<InvariantGlobalization>true</InvariantGlobalization>
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>


	<ItemGroup>
    <Content Include="LOGO_OFFICIAL_WHITE_SMALL - Copy.ico" />
    <Content Include="Markadian Icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="D:\Filip's Site Resources\LOGOS\Markadian Icon.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="TagLibSharp" />
		<TrimmerRootAssembly Include="Xabe.FFmpeg" />
		<TrimmerRootAssembly Include="YoutubeExplode" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
    <PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />
    <PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
    <PackageReference Include="YoutubeExplode" Version="6.5.4" />
    <PackageReference Include="YoutubeExplode.Converter" Version="6.5.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ffplay.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ffprobe.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="yt-dlp.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>